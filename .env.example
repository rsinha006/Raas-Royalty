# Copy to .env and adjust. Everything has a working default except ADMIN_PASSWORD,
# which you should set before the event.

PORT=4000

# Shared password for the /admin panel. CHANGE THIS.
ADMIN_PASSWORD=royalty-admin

# Optional: pin the cookie-signing secret so admin sessions survive a redeploy.
# SESSION_SECRET=

# Where the SQLite file lives.
# DB_PATH=./data/royalty.db

# ---------------------------------------------------------------------------
# Event timezone. The server resolves every schedule time against this before it
# reaches a phone, so nobody's device clock can shift the schedule.
#
# Must be an IANA region name. An abbreviation or a fixed offset ("EST",
# "-05:00") ignores daylight saving and would render the whole event an hour out
# from March to November — the server refuses to start on one rather than serve
# a silently wrong schedule.
# ---------------------------------------------------------------------------
# EVENT_TIMEZONE=America/Indiana/Indianapolis

# Base URL for the access links in the admin CSV export, and the canonical
# origin allowed to open a live socket. Set this at deploy: behind a proxy the
# request's host header is whatever the proxy passed along.
# PUBLIC_BASE_URL=https://schedule.example.org

# Extra origins allowed to open a Socket.IO connection, comma-separated. The
# request's own host is always allowed, so this is only needed for a genuinely
# separate front end. In development, localhost and private-network origins are
# allowed too, which is what lets the Vite dev server and a phone on the same
# wifi connect.
# SOCKET_ORIGINS=https://ops.example.org

# ---------------------------------------------------------------------------
# Schedule source. Default is `upload` (the interim manual import).
#   upload         — admin uploads a .csv/.xlsx in the panel
#   url            — poll/pull a published spreadsheet URL (Sheets "Publish to web → CSV")
#   google_sheets  — Google Sheets API v4
# ---------------------------------------------------------------------------
SCHEDULE_SOURCE=upload

# SCHEDULE_SOURCE=url
# SCHEDULE_SOURCE_URL=https://docs.google.com/spreadsheets/d/e/XXXX/pub?gid=0&single=true&output=csv

# SCHEDULE_SOURCE=google_sheets
# GOOGLE_SHEET_ID=
# GOOGLE_API_KEY=
# GOOGLE_SHEET_RANGE=Schedule!A:I

# Seconds between automatic pulls. 0 / unset = manual only.
SYNC_POLL_SECONDS=0

# Set to 1 if running behind plain HTTP in production (not recommended).
# INSECURE_COOKIES=0
