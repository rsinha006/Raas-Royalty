# Copy to .env and adjust. Everything has a working default for local
# development, and almost nothing does in production.
#
# ⚠️ In production (NODE_ENV=production) the server checks this configuration
# before it serves anything and refuses to start on four of the settings below.
# Every one of them otherwise produces a server that looks completely healthy —
# see server/lib/deploy-config.js. Check any environment with:
#
#   npm run preflight
#
# The deployed values are set with `fly secrets set`, not in a file. See
# docs/deploy.md.

PORT=4000

# Shared password for the /admin panel. CHANGE THIS — this default is published
# in the README, and the panel has write access to the live schedule.
# Required in production:  fly secrets set ADMIN_PASSWORD="$(openssl rand -base64 18)"
ADMIN_PASSWORD=royalty-admin

# Signing key for both the admin and the viewer session cookies.
#
# Unset, the server generates one and stores it in the database. That works, but
# it puts a live signing key inside the file that gets backed up off-box every
# few minutes, and a rebuilt volume discards it and signs all ~280 phones out
# mid-event. Required in production:
#   fly secrets set SESSION_SECRET="$(openssl rand -hex 32)"
# SESSION_SECRET=

# Where the SQLite file lives. ⚠️ In production this must be on a persistent
# volume, NOT inside the deployed directory — a container filesystem is rebuilt
# by every deploy, so the schedule would silently reset to empty on the next
# push. The server refuses to start if this resolves inside the app directory.
# DB_PATH=./data/royalty.db          # local
# DB_PATH=/data/royalty.db           # deployed, onto the mounted volume

# ---------------------------------------------------------------------------
# Event timezone. The server resolves every schedule time against this before it
# reaches a phone, so nobody's device clock can shift the schedule.
#
# Must be an IANA region name. An abbreviation or a fixed offset ("EST",
# "-05:00") ignores daylight saving and would render the whole event an hour out
# from March to November — the server refuses to start on one rather than serve
# a silently wrong schedule.
# ---------------------------------------------------------------------------
# EVENT_TIMEZONE=America/Indiana/Indianapolis

# Base URL for the access links in the admin CSV export, and the canonical
# origin allowed to open a live socket. Set this at deploy: behind a proxy the
# request's host header is whatever the proxy passed along.
# PUBLIC_BASE_URL=https://schedule.example.org

# Extra origins allowed to open a Socket.IO connection, comma-separated. The
# request's own host is always allowed, so this is only needed for a genuinely
# separate front end. In development, localhost and private-network origins are
# allowed too, which is what lets the Vite dev server and a phone on the same
# wifi connect.
# SOCKET_ORIGINS=https://ops.example.org

# ---------------------------------------------------------------------------
# Schedule source. Default is `upload` (the interim manual import).
#   upload         — admin uploads a .csv/.xlsx in the panel
#   url            — poll/pull a published spreadsheet URL (Sheets "Publish to web → CSV")
#   google_sheets  — Google Sheets API v4
# ---------------------------------------------------------------------------
SCHEDULE_SOURCE=upload

# The steady state for the event: publish the workbook's **Export** tab (File >
# Share > Publish to web > Export > CSV) and point this at that URL. Export is
# the only tab the app reads — see docs/loading-data.md.
# SCHEDULE_SOURCE=url
# SCHEDULE_SOURCE_URL=https://docs.google.com/spreadsheets/d/e/XXXX/pub?gid=0&single=true&output=csv

# SCHEDULE_SOURCE=google_sheets
# GOOGLE_SHEET_ID=
# GOOGLE_API_KEY=
# GOOGLE_SHEET_RANGE=Export!A:I

# Seconds between automatic pulls. 0 / unset = manual only.
SYNC_POLL_SECONDS=0

# Set to 1 if running behind plain HTTP in production (not recommended). With
# force_https at the proxy this is never needed, and it sends both session
# cookies in the clear.
# INSECURE_COOKIES=0

# How many proxy hops to trust when deriving the client IP the rate limiters key
# on. Fly's proxy is exactly one. Set 0 only if the process is exposed directly,
# because otherwise a client can forge X-Forwarded-For and look like a new IP on
# every request. Getting it wrong the other way is worse during the event: with
# no proxy trusted, every attendee shares the balancer's IP and ten fumbled
# codes lock the whole roster out.
# TRUST_PROXY=1

# How long an idle connection is held open. Must stay ABOVE the idle timeout of
# whatever proxy is in front (Fly's is 60s), so the proxy is always the side
# that closes. If this process closes first, a phone reusing the socket in that
# instant gets ECONNRESET — which the viewer cannot tell from being offline, so
# it shows "Offline · last known" on full signal.
# KEEP_ALIVE_TIMEOUT_MS=65000

# ---------------------------------------------------------------------------
# Backups, monitoring and alerting — item 23. Runbook: docs/ops.md.
#
# Off outside production. On the machine the defaults are a verified snapshot
# every 5 minutes, 48 kept, pruned at 256MB — the volume also holds the
# database, and filling it takes the event down in the most confusing way
# available (writes fail while every health check still passes).
# ---------------------------------------------------------------------------
# BACKUP_INTERVAL_MS=300000          # 0 disables snapshots entirely
# BACKUP_DIR=                        # defaults to <database directory>/snapshots
# BACKUP_KEEP=48
# BACKUP_MAX_BYTES=268435456

# Where a snapshot goes so that it survives losing the machine. A copy beside
# the database is a restore path for a bad import and nothing more. Either one:
# BACKUP_TARGET_URL=https://backups.example.org/royalty     # HTTP PUT, {name} appended
# BACKUP_TARGET_TOKEN=                                      # sent as `Authorization: Bearer`
# BACKUP_TARGET_CMD=aws s3 cp {file} s3://royalty-backups/{name}

# ⚠️ The alarm that survives the failure it watches for. Nothing running inside
# this process can report that this process has stopped, so an external
# dead-man's switch (healthchecks.io, Better Stack, Cronitor) is what actually
# sends the SMS. Point it at a check with SMS enabled.
# HEARTBEAT_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000
# HEARTBEAT_INTERVAL_MS=60000

# Where in-process errors go — a Slack or Discord incoming webhook works
# unmodified. Deduplicated per condition; ALERT_MIN_INTERVAL_MS is the window.
# ALERT_WEBHOOK_URL=
# ALERT_MIN_INTERVAL_MS=300000

# ---------------------------------------------------------------------------
# Who answers the alarm — item 28
# ---------------------------------------------------------------------------
# The heartbeat above pages somebody; this is the somebody. It is deploy
# configuration rather than roster data because the person on call changes with
# the weekend, not with the spreadsheet — and it has to be a name, not a rota:
# "whoever notices" is nobody. Not somebody also running a camera or a stage.
#
# It is also the "On call for the app" line on the printed desk sheet
# (`npm run callsheets`), which prints a ruled blank when this is unset rather
# than quietly dropping the section.
# ON_CALL_NAME=Priya Raman
# ON_CALL_PHONE=+1 555 0147
