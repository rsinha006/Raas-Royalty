{
  "name": "royalty-schedule",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Live personalized event schedules for a dance competition",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "seed:reset": "node server/seed.js --reset",
    "codes": "node server/codes.js",
    "days": "node scripts/event-days.js",
    "preflight": "node scripts/preflight.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "load-test": "node scripts/load-test.js",
    "test": "node --test tests/*.test.js",
    "ci": "npm run build && npm test",
    "postinstall": "npm --prefix client install"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "multer": "^2.2.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "socket.io-client": "^4.8.3"
  },
  "overrides": {
    "uuid": "^11.1.0"
  }
}
